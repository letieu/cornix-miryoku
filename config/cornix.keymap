// Miryoku on the Cornix (jzf/cornix ZMK boards)
//
//   Miryoku ZMK:          https://github.com/manna-harbour/miryoku_zmk
//   Cornix board module:  https://github.com/hitsmaxft/zmk-keyboard-cornix
//
// Physical position mapping: config/includes/miryoku_cornix.h
// Miryoku options are plain C defines placed before the includes below
// (the default alphas layout is Colemak Mod-DH).
//
//   #define MIRYOKU_ALPHAS_QWERTY
#define MIRYOKU_NAV_VI
//   #define MIRYOKU_NAV_VI
//   #define MIRYOKU_LAYERS_FLIP
//   #define MIRYOKU_KLUDGE_THUMBCOMBOS
//
// Full list: https://github.com/manna-harbour/miryoku_zmk#options

#define MIRYOKU_ALPHAS_QWERTY
#define MIRYOKU_NAV_VI

#include "../miryoku_zmk/miryoku/custom_config.h"
#include "includes/miryoku_cornix.h"

// Layer contents generated from the Vial export the keyboard actually runs, so
// the Cmd/Ctrl swap, the hand-tuned keys and the mouse layer match the .vil.
// miryoku_layer_selection.h uses MIRYOKU_LAYER_<NAME> if it is already defined.
#include "includes/miryoku_keys_generated.h"

#include "../miryoku_zmk/miryoku/miryoku.dtsi"

// ---------------------------------------------------------------------------
// "Timeless" home-row mods (urob's configuration, ZMK flavour).
//
// The tapping term stops mattering for normal typing: a mod resolves as hold as
// soon as another key is pressed *and released* ("balanced"), a tap right after
// another key resolves instantly (require-prior-idle = flow tap), and a same-hand
// roll can never become a mod (hold-trigger-key-positions = opposite hand).
// hold-trigger-on-release keeps same-hand mod+mod chording possible.
//
// Keymap positions (see includes/miryoku_cornix.h):
//   0-11   top row    left outer..inner, then right inner..outer
//   12-23  home row   same order
//   24-37  bottom row + the two inner keys (30, 31)
//   38-40  left palms, 41-43 left thumbs, 44-46 right thumbs, 47-49 right palms
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 30 38 39 40
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 31 32 33 34 35 36 37 47 48 49
#define THUMBS 41 42 43 44 45 46

/ {
  behaviors {
    hml: hml {                       // left-hand home-row mods
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      tapping-term-ms = <280>;
      quick-tap-ms = <175>;
      require-prior-idle-ms = <150>;
      bindings = <&kp>, <&kp>;
      hold-trigger-key-positions = <KEYS_R THUMBS>;
      hold-trigger-on-release;
    };
    hmr: hmr {                       // right-hand home-row mods
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      tapping-term-ms = <280>;
      quick-tap-ms = <175>;
      require-prior-idle-ms = <150>;
      bindings = <&kp>, <&kp>;
      hold-trigger-key-positions = <KEYS_L THUMBS>;
      hold-trigger-on-release;
    };
  };
};

// Layer-taps keep Miryoku's tap-preferred behaviour, only with the .vil timings.
&u_lt {
  tapping-term-ms = <200>;
  quick-tap-ms = <150>;
  require-prior-idle-ms = <150>;
  hold-trigger-on-release;
};

// Pointer feel.
//
// Miryoku ships ZMK's mouse-move behavior with max speed 1250 px/s, but ramps
// from 0 over 1500 ms, so the first third of a second barely moves. Bring the
// ramp down to 300 ms, drop the initial dead time and report twice as often
// (8 ms instead of 16 ms). These override miryoku/miryoku_mousekeys.dtsi, which
// is included above.
//
// Speed itself is per-binding: &mmv MOVE_UP == ZMK_POINTING_DEFAULT_MOVE_VAL
// (1250 px/s), fixed in miryoku_zmk. Want more? Add your own behavior, e.g.
//
//   / {
//     behaviors {
//       mmvfast: mouse_move_fast {
//         compatible = "zmk,behavior-input-two-axis";
//         #binding-cells = <1>;
//         x-input-code = <INPUT_REL_X>;
//         y-input-code = <INPUT_REL_Y>;
//         time-to-max-speed-ms = <250>;
//         acceleration-exponent = <1>;
//       };
//     };
//     mmvfast_input_listener: mmvfast_input_listener {
//       compatible = "zmk,input-listener";
//       device = <&mmvfast>;
//     };
//   };
//
// and bind `&mmvfast MOVE(0, -3000)` on a layer of your own.
&mmv {
  acceleration-exponent = <1>;
  time-to-max-speed-ms = <300>;
  delay-ms = <0>;
  trigger-period-ms = <8>;
};
